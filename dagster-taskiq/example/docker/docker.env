POSTGRES_HOST="postgresql"
POSTGRES_USER="username"
POSTGRES_PASSWORD="password"
POSTGRES_DB="dagster"
POSTGRES_PORT="5432"

# AWS Configuration (for production, use IAM roles)
AWS_DEFAULT_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=  # Set for local testing
# AWS_SECRET_ACCESS_KEY=  # Set for local testing
AWS_ACCOUNT_ID="123456789012"

# AWS SQS Configuration
DAGSTER_TASKIQ_SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/dagster-tasks"
# DAGSTER_TASKIQ_SQS_ENDPOINT_URL=  # Optional: for testing with moto

# AWS S3 Configuration (for TaskIQ result backend)
DAGSTER_TASKIQ_S3_BUCKET_NAME="dagster-taskiq-results"
# DAGSTER_TASKIQ_S3_ENDPOINT_URL=  # Optional: for testing with moto
